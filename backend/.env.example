# Direct host development only. Docker Compose reads ../.env instead.
APP_NAME=contract-review-assistant
APP_ENV=development
APP_DEBUG=true
DATABASE_URL=postgresql+psycopg://contract_review:URL_ENCODED_PASSWORD@localhost:5432/contract_review
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_ROOT=../storage
MAX_FILE_SIZE_MB=20
MAX_REVIEW_CHARACTERS=120000
DOCUMENT_PAGE_CHARACTERS=3000
OCR_MIN_PAGE_CHARACTERS=30
OCR_LANGUAGE=chi_sim+eng
OCR_TIMEOUT_SECONDS=90
AUTH_SESSION_HOURS=24
CAPTCHA_EXPIRE_MINUTES=5
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=
MODEL_CONFIG_ENCRYPTION_KEY=
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096
MODEL_REQUEST_TIMEOUT_SECONDS=300
