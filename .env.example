# Docker Compose application settings
COMPOSE_PROJECT_NAME=contract-review

APP_NAME=contract-review-assistant
APP_ENV=docker
APP_DEBUG=false

# Required PostgreSQL settings. Set a strong password before startup.
POSTGRES_DB=contract_review
POSTGRES_USER=contract_review
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# Published service ports. Nginx serves the website and proxies /api to FastAPI.
FRONTEND_PORT=8080
FRONTEND_BIND_ADDRESS=0.0.0.0
BACKEND_PORT=8000
BACKEND_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Document processing
MAX_FILE_SIZE_MB=20
MAX_REVIEW_CHARACTERS=120000
DOCUMENT_PAGE_CHARACTERS=3000
OCR_MIN_PAGE_CHARACTERS=30
OCR_LANGUAGE=chi_sim+eng
OCR_TIMEOUT_SECONDS=90

# Authentication. Initial admin settings are optional, but must be provided together.
AUTH_SESSION_HOURS=24
CAPTCHA_EXPIRE_MINUTES=5
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# System model defaults. MODEL_API_KEY is optional when an encrypted key is saved by an admin.
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-chat
MODEL_API_BASE=https://api.deepseek.com
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096
MODEL_REQUEST_TIMEOUT_SECONDS=300

# Required stable Fernet key. Generate once and back it up; never rotate it casually.
MODEL_CONFIG_ENCRYPTION_KEY=
